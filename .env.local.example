# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# OpenAI API Key (preferred)
OPEN_AI_KEY=your_openai_api_key_here
# Optional fallback name used by some libraries
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Configuration
GITHUB_REPO=https://api.github.com/repos/your_username/your_repo
GITHUB_TOKEN=your_github_token_here
GITHUB_MEMBER=https://api.github.com/users/your_username

# GitHub OAuth (for NextAuth)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth (for NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret


# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
# NOTE: do NOT set NEXTAUTH_URL on the home deployment.
# This site is served from multiple hostnames (blog.huangjien.com,
# www.huangjien.com) through the gateway. NextAuth v4 derives the canonical
# URL from the inbound Host header when NEXTAUTH_URL is unset — which is what
# we need. Only set NEXTAUTH_URL=http://localhost:<port> for local dev.