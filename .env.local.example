# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# OpenAI API Key (preferred)
OPEN_AI_KEY=your_openai_api_key_here
# Optional fallback name used by some libraries
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Configuration
GITHUB_REPO=https://api.github.com/repos/your_username/your_repo
GITHUB_TOKEN=your_github_token_here
GITHUB_MEMBER=https://api.github.com/users/your_username

# Blog publishing owner allowlist (server-only, comma-separated)
# Only these signed-in email addresses can create blog Issues.
BLOG_AUTHOR_EMAILS=your_email@example.com

# Dev-only session injection (local testing only).
# POST /api/dev/session with {"email":"your_email@example.com"} from 127.0.0.1
# to set a NextAuth session cookie without going through GitHub OAuth.
# Only works when NODE_ENV != "production" AND request is from loopback.
# In production it returns 404 (indistinguishable from a missing route).

# GitHub OAuth (for NextAuth)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth (for NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret


# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
# Set NEXTAUTH_URL to the canonical public host the OAuth app is registered
# for. Currently: https://blog.huangjien.com (single hosted OAuth app).
# For local dev, point it at your local port instead, e.g.
#   NEXTAUTH_URL=http://localhost:8080